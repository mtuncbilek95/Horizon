{
  "version": 3,
  "configurePresets": [
    {
      "name": "Win64-Base",
      "hidden": true,
      "binaryDir": "${sourceDir}/Build/${presetName}",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "HORIZON_ROOT": "D:/Projects/Horizon",
        "HORIZON_PRESET": "${presetName}"
      }
    },
    {
      "name": "Win64-Debug",
      "displayName": "Win64-Debug",
      "inherits": "Win64-Base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Win64-Release",
      "displayName": "Win64-Release",
      "inherits": "Win64-Base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}